    {
      "parameters": {
        "command": "={{ `${$json.repo_dir}/.venv/bin/python ${$json.repo_dir}/run_packaging_batch.py \"${$json.input_path}\"${$json.ocr ? ' --ocr' : ''} --output-json \"${$json.output_json}\"` }}"
      },
      "id": "6bbd4cb9-b07d-4dd0-a902-6d7d3c5da422",
      "name": "Run Parser Batch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.stdout || $json.data || $json;\nconst payload = typeof raw === 'string' ? JSON.parse(raw) : raw;\n\nreturn payload.records.map((record) => {\n  const review = record.review || {};\n  return {\n    json: {\n      file: record.file,\n      review_needed: !!review.review_needed,\n      review_fields_count: review.review_fields_count || 0,\n      review_fields: JSON.stringify(review.review_fields || []),\n      source_summary: JSON.stringify(review.source_counts || {}),\n      confidence_summary: JSON.stringify(review.confidence_counts || {}),\n      missing_fields_count: record.missing_fields_count,\n      ...record.sheet_row,\n    },\n  };\n});"
      },
      "id": "1e9ff7bb-07e5-4d7c-9af8-b8d5b07a0cc3",
      "name": "Expand Records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "0f9201cb-b7e5-42f6-bcd1-6f7696fe4a15",
              "leftValue": "={{ $json.review_needed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "6f4ce7c4-f38c-450a-91cf-b6891b118fe7",
